[Desktop Entry]
Type=Application
Name=Fast Camera
Icon=icon-launcher-camera
Exec=/usr/bin/invoker --type=silica-media,silica-qt5 -A -- /usr/bin/fastcamera
Comment=Camera with a bounded shutter focus wait

[X-Sailjail]
ApplicationName=fastcamera
OrganizationName=local
Permissions=Camera;Audio;Microphone;Pictures;Videos;MediaIndexing;Location;Privileged;Ambience;RemovableMedia
